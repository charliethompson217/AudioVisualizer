{
  "name": "@audiovisualizer/spectrum",
  "version": "0.1.1",
  "description": "Framework-independent TypeScript frequency-spectrum visualizer with an optional React adapter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charliethompson217/AudioVisualizer.git",
    "directory": "packages/spectrum"
  },
  "bugs": "https://github.com/charliethompson217/AudioVisualizer/issues",
  "homepage": "https://github.com/charliethompson217/AudioVisualizer/tree/main/packages/spectrum#readme",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "audio",
    "visualizer",
    "spectrum",
    "frequency",
    "fft",
    "web-audio",
    "typescript",
    "react"
  ],
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
